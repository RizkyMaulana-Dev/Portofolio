---
import Container from "../ui/Container.astro";
import Badge from "../ui/Badge.astro";
import { Icon } from "astro-icon/components";
import { profile } from "../../data/profile";
import { socials } from "@/data/socials";

const currentYear = new Date().getFullYear();
---

<section
  class="bg-white py-20 transition-colors duration-300 sm:py-28 dark:bg-neutral-950 border-t border-neutral-100 dark:border-neutral-800/40"
>
  <Container id="contact">
    <div class="max-w-4xl mx-auto">
      <!-- Contact Card -->
      <div class="relative overflow-hidden rounded-3xl border border-neutral-200 bg-white p-6 sm:p-12 text-center shadow-lg transition-colors duration-300 dark:border-neutral-800 dark:bg-neutral-900" data-anim="up">
        <!-- Glow effect -->
        <div
          class="absolute -right-40 top-0 h-80 w-80 rounded-full bg-blue-500/10 blur-3xl"
          aria-hidden="true"
        />

        <Badge class="mb-4">
          <Icon name="mdi:email-outline" class="mr-1.5 h-4 w-4" />
          Contact
        </Badge>

        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-neutral-900 dark:text-white">
          Let's Build Something <span class="text-blue-600 dark:text-blue-400">Great</span>
        </h2>

        <p class="mt-4 mx-auto max-w-xl text-sm sm:text-base text-neutral-600 dark:text-neutral-400">
          Open to discuss backend architecture, API design, DevOps, or full-stack opportunities.
        </p>

        <!-- Action Buttons -->
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row sm:gap-4">
          <a
            href={`mailto:${profile.email || 'emailmu@domain.com'}`}
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-neutral-900 px-5 py-3 text-sm font-semibold text-white transition-all duration-200 hover:bg-neutral-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200"
          >
            <Icon name="mdi:email" class="h-4 w-4" />
            Email Me
          </a>

          <a
            href={`${import.meta.env.BASE_URL}/pdfs/FULLSTACK_DEVELOPER_RIZKY_MAULANA_ID.pdf`}
            download="CV_Rizky_Maulana_ID.pdf"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-neutral-300 px-5 py-3 text-sm font-semibold text-neutral-700 transition-all duration-200 hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-200 dark:hover:bg-neutral-800"
          >
            <Icon name="mdi:file-document" class="h-4 w-4" />
            CV ID
          </a>

          <a
            href={`${import.meta.env.BASE_URL}/pdfs/FULLSTACK_DEVELOPER_RIZKY_MAULANA_EN.pdf`}
            download="CV_Rizky_Maulana_EN.pdf"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-neutral-300 px-5 py-3 text-sm font-semibold text-neutral-700 transition-all duration-200 hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-200 dark:hover:bg-neutral-800"
          >
            <Icon name="mdi:translate" class="h-4 w-4" />
            CV EN
          </a>
        </div>

        <!-- Social Links -->
        <div class="mt-10 flex flex-wrap justify-center items-center gap-2 sm:gap-4 border-t border-neutral-200 dark:border-neutral-800 pt-8">
          {socials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.name}
              class="group flex items-center justify-center gap-2 rounded-full bg-neutral-100 px-3 py-2 text-sm font-medium text-neutral-600 transition-all duration-300 hover:bg-neutral-200 hover:text-blue-600 dark:bg-neutral-800 dark:text-neutral-400 dark:hover:bg-neutral-700 dark:hover:text-blue-400"
            >
              <Icon
                name={social.icon}
                class="h-4 w-4 transition-transform duration-300 group-hover:scale-110"
              />
              <span class="hidden sm:inline">{social.name}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Copyright -->
      <div class="mt-12 text-center">
        <p class="text-xs text-neutral-400 dark:text-neutral-600">
          &copy; {currentYear} {profile.name || 'Rizky Maulana'}. Built with Astro & Tailwind CSS.
        </p>
      </div>
    </div>
  </Container>
</section>