---
interface Props {
  images: string[];
  alt: string;
  intervalMs?: number;
  class?: string;
  imgClass?: string;
  firstLoading?: "eager" | "lazy";
}

const {
  images,
  alt,
  intervalMs = 2000,
  class: className = "",
  imgClass = "",
  firstLoading = "lazy",
} = Astro.props;

const hasMultiple = images.length > 1;
---

{
  images.length === 0 ? (
    <div class:list={["image-carousel", className]} aria-hidden="true" />
  ) : hasMultiple ? (
    <div
      class:list={["image-carousel", className]}
      data-carousel
      data-count={images.length}
      data-interval={intervalMs}
      data-index="0"
      role="group"
      aria-label={`${alt} — ${images.length} gambar`}
    >
      <div class="ic-track">
        {
          images.map((src, i) => (
            <div class="ic-slide">
              <img
                src={src}
                alt={`${alt} — gambar ${i + 1}`}
                class:list={["ic-img", imgClass]}
                loading={i === 0 ? firstLoading : "lazy"}
                draggable="false"
              />
            </div>
          ))
        }
      </div>
    </div>
  ) : (
    <div
      class:list={["image-carousel", className]}
      role="group"
      aria-label={alt}
    >
      <img src={images[0]} alt={alt} class:list={["ic-img", imgClass]} loading={firstLoading} />
    </div>
  )
}

<style>
  .image-carousel {
    position: relative;
    height: 100%;
    width: 100%;
    overflow: hidden;
  }

  .ic-track {
    display: flex;
    height: 100%;
    width: 100%;
    transform: translate3d(calc(var(--i, 0) * -100%), 0, 0);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .ic-slide {
    flex: 0 0 100%;
    height: 100%;
  }

  .ic-img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
</style>

<script>
  import "@/scripts/init-carousel";
</script>
