---
interface Props {
  images: string[];
  alt?: string;
  maxPreview?: number;
  placeholder?: string;
}

const { images, alt = 'Project screenshot', maxPreview = 5, placeholder } = Astro.props;

// Get fallback image
const fallbackImage = placeholder || `${import.meta.env.BASE_URL}/images/placeholder.png`;

// Filter out empty/undefined images
const validImages = images.filter(img => img && img.trim() !== '');

// Determine layout based on image count
const imageCount = validImages.length;

// Get preview images (max 5 for list view)
const previewImages = validImages.slice(0, maxPreview);
---

{/* Project Image Gallery/Mosaic */}
<div class="group relative overflow-hidden rounded-2xl bg-neutral-100 dark:bg-neutral-800">
  {imageCount === 0 ? (
    // No images - show placeholder
    <div class="flex h-full w-full items-center justify-center">
      <img 
        src={fallbackImage} 
        alt={alt}
        class="max-w-full max-h-full object-contain"
      />
    </div>
  ) : imageCount === 1 ? (
    // Single image - show full
    <img 
      src={previewImages[0]} 
      alt={alt}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  ) : imageCount === 2 ? (
    // Two images - side by side
    <div class="grid grid-cols-2 h-full">
      <img 
        src={previewImages[0]} 
        alt={`${alt} - 1`}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
      <img 
        src={previewImages[1]} 
        alt={`${alt} - 2`}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </div>
  ) : imageCount === 3 ? (
    // Three images - 2 rows, first row spans 2 cols
    <div class="grid grid-cols-2 h-full gap-1">
      <img 
        src={previewImages[0]} 
        alt={`${alt} - 1`}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 row-span-2"
      />
      <img 
        src={previewImages[1]} 
        alt={`${alt} - 2`}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 col-span-2"
      />
      <img 
        src={previewImages[2]} 
        alt={`${alt} - 3`}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </div>
  ) : (
    // 4+ images - bento/mosaic grid
    <div class="grid grid-cols-2 sm:grid-cols-3 h-full gap-1">
      {previewImages.map((img, idx) => (
        <img 
          key={idx}
          src={img} 
          alt={`${alt} - ${idx + 1}`}
          class={`object-cover transition-transform duration-500 group-hover:scale-105 ${
            idx === 0 ? 'row-span-2' : ''
          } ${
            idx === 1 ? 'col-span-2 row-span-1' : ''
          } ${
            idx >= 2 && idx < 5 ? 'col-span-1 row-span-1' : ''
          }`}
        />
      ))}
    </div>
  )}</div>

{/* Optional: Show image count if more than preview */}
{imageCount > maxPreview && (
  <div class="absolute bottom-2 right-2 bg-black/60 text-white text-xs px-2 py-1 rounded">
    +{imageCount - maxPreview} more
  </div>
)}
---