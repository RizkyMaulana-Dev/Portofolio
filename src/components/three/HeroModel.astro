---
/**
 * HeroModel — GLB statis di belakang Hero section.
 * - Diam (tidak ada idle animation / parallax) sampai user scroll
 * - Saat scroll di dalam hero: model bergerak MENDEKAT (towards camera)
 * - Ter-scope ke hero section: crop/scroll di luar hero = tidak ada efek
 * - Reduced motion: sepenuhnya statis (tidak ada respons scroll)
 */
interface Props {
  src: string;
  class?: string;
}
const { src, class: className = "" } = Astro.props;
---

<div
  class:list={["hero-model pointer-events-none absolute inset-0 z-0 overflow-hidden", className]}
  aria-hidden="true"
  data-src={src}
>
  <canvas class="block h-full w-full opacity-0 transition-opacity duration-1000" data-canvas></canvas>
</div>

<script>
  import * as THREE from "three";
  import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";

  const root = document.querySelector<HTMLElement>(".hero-model");
  const canvas = root?.querySelector<HTMLCanvasElement>("[data-canvas]");

  if (root && canvas) {
    const src = root.dataset.src!;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const section = root.closest("section") as HTMLElement | null;

    /* Renderer */
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: "low-power",
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
    camera.position.set(0, 0, 9); // "agak jauh"

    /* Lighting netral */
    scene.add(new THREE.AmbientLight(0xffffff, 1.6));
    const key = new THREE.DirectionalLight(0xffffff, 2.2);
    key.position.set(4, 6, 8);
    scene.add(key);
    const rim = new THREE.DirectionalLight(0x93c5fd, 1.4);
    rim.position.set(-6, -2, -4);
    scene.add(rim);

    /* Holder dipisah supaya bisa di-offset z tanpa menyentuh model */
    const holder = new THREE.Group();
    scene.add(holder);

    /* Resize */
    const resize = () => {
      const w = root.clientWidth;
      const h = root.clientHeight;
      if (!w || !h) return;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    };
    resize();
    window.addEventListener("resize", resize, { passive: true });

    /* Load GLB */
    let model: THREE.Object3D | null = null;
    const basePos = new THREE.Vector3(-1.9, 0, 0);

    new GLTFLoader().load(
      src,
      (gltf) => {
        model = gltf.scene;
        holder.add(model);

        /* Normalize scale + center */
        const box = new THREE.Box3().setFromObject(model);
        const size = box.getSize(new THREE.Vector3());
        const center = box.getCenter(new THREE.Vector3());
        const maxDim = Math.max(size.x, size.y, size.z) || 1;
        model.position.sub(center);
        model.scale.setScalar(1.15 / maxDim);
        model.position.copy(basePos);

        renderer.render(scene, camera);
        canvas.classList.remove("opacity-0");
        update(0);
      },
      undefined,
      (err) => console.warn("[hero-model] gagal memuat GLB:", err)
    );

    /* ---------- Scroll-linked: model MENDEKAT ---------- */
    /* Hanya aktif saat hero terlihat; di luar hero = tanpa efek */
    let inHero = true;
    new IntersectionObserver(([e]) => (inHero = e.isIntersecting), { threshold: 0 }).observe(root);

    let raf = 0;
    const update = (scrollY: number) => {
      if (!model) return;
      const HERO_H = section?.offsetHeight ?? window.innerHeight;
      // progress 0→1 hanya di dalam rentang scroll hero
      const p = Math.min(Math.max(scrollY / HERO_H, 0), 1);
      holder.position.z = p * 3.6; // mendekat ke kamera
      renderer.render(scene, camera);
    };

    const onScroll = () => {
      if (reduced || !inHero) return;
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        update(window.scrollY);
      });
    };

    if (!reduced) window.addEventListener("scroll", onScroll, { passive: true });
    update(0);
  }
</script>