---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
import Badge from "../ui/Badge.astro";
import { Image } from "astro:assets";
import profileImage from "../../assets/images/profile.webp";
import { profile } from "../../data/profile";
import { skills } from "@/data/skills";
import { Icon } from "astro-icon/components";
---

<Section class="relative overflow-hidden bg-white transition-colors duration-300 dark:bg-neutral-950">
  <Container>
    <div class="grid items-center gap-12 md:grid-cols-2 md:gap-16 lg:gap-20" data-hero>

      <!-- Left -->
      <div class="text-center md:text-left">

        <Badge class="mb-6" data-anim="fade" data-anim-delay="0">
          <Icon name="mdi:hand-wave" class="mr-1.5 h-4 w-4" />
          Available for Work
        </Badge>

        <h1
          class="text-4xl font-extrabold leading-tight tracking-tight text-neutral-900 sm:text-5xl lg:text-6xl xl:text-7xl dark:text-white"
          data-anim="up"
          data-anim-delay="80"
        >
          Hi, I'm{" "}
          <span class="text-blue-600 dark:text-blue-400">
            {profile.name.split(" - ")[0]}
          </span>
          <br />
          <span class="text-neutral-400 dark:text-neutral-400">Fullstack Developer</span>
        </h1>

        <p
          class="mt-6 max-w-xl text-base text-neutral-600 sm:text-lg sm:leading-8 md:mx-0 dark:text-neutral-400"
          data-anim="up"
          data-anim-delay="160"
        >
          I build modern, scalable and high-performance web applications with a strong focus on clean architecture, maintainability and user experience.
        </p>

        <!-- Core Skills Preview -->
        <div class="mt-8 flex flex-wrap items-center gap-2" data-anim="up" data-anim-delay="240">
          <span class="text-xs font-semibold text-neutral-500 dark:text-neutral-400">
            Stack:
          </span>
          {skills.slice(0, 6).map((skill) => (
            <span
              class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-600 dark:bg-blue-950/40 dark:text-blue-400"
            >
              <Icon name={skill.icon} class="h-3.5 w-3.5" style={`color: ${skill.color}`} />
              {skill.name}
            </span>
          ))}
          <span class="text-xs text-neutral-400 dark:text-neutral-400">...</span>
        </div>

        <div class="mt-8 flex flex-wrap justify-center gap-4 sm:mt-10 md:justify-start" data-anim="up" data-anim-delay="320">

          <Button href={`${import.meta.env.BASE_URL}/links`} data-magnetic="0.18">
            <Icon name="mdi:email" class="mr-1.5 h-4 w-4" />
            Contact
          </Button>

          <Button
            href={`${import.meta.env.BASE_URL}/projects`}
            variant="secondary"
            class="hover"
            data-magnetic="0.18"
          >
            <Icon name="mdi:folder" class="mr-1.5 h-4 w-4" />
            Projects
          </Button>

        </div>

      </div>

      <!-- Right -->
      <div class="flex justify-center md:justify-end" data-anim="zoom" data-anim-delay="200">
        <div class="relative">
          <div
            class="flex aspect-square w-48 items-center justify-center rounded-3xl bg-neutral-100 text-neutral-500 shadow-xl sm:w-56 md:w-64 lg:w-72 dark:bg-neutral-800 dark:text-neutral-400 dark:shadow-neutral-900/50 overflow-hidden"
            data-anim="zoom"
          >
            <Image
              src={profileImage}
              alt="Foto Profil"
              class="w-full h-full object-cover"
              width={320}
              height={320}
              loading="eager"
              fetchpriority="high"
            />
          </div>

          <!-- Floating skill badges -->
          <div class="absolute -bottom-6 -right-6 hidden lg:block">
            <div class="flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-lg dark:bg-neutral-900">
              <span class="text-sm font-bold text-blue-600 dark:text-blue-400">
                10+ Projects
              </span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </Container>
</Section>