---
import MainLayout from "@/layouts/MainLayout.astro";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
import { Projects } from "@/data/projects";

const uniqueCategories = ["ALL", ...new Set(Projects.map(p => p.category))];
const uniqueRoles = ["ALL", ...new Set(Projects.map(p => p.role))];

// Ambil hanya project pertama
const firstProject = Projects[0];
---
  <Section class="bg-white transition-colors duration-300 dark:bg-neutral-950 py-20 sm:py-32">
    <Container>
      
      <!-- Header Halaman & Filter UI -->
      <div class="max-w-4xl mb-20">
        <span class="text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400 block mb-3">
          ARCHIVE / WORK SPECIFICATIONS
        </span>
        <h1 class="text-4xl font-black tracking-tight text-neutral-900 sm:text-5xl md:text-6xl dark:text-white">
          Favourite Project
        </h1>
      </div>

      <!-- List Baris Proyek Premium - Hanya Project Pertama -->
      <div id="projects-container" class="flex flex-col gap-24 sm:gap-32">
        {
          firstProject ? (
            <div 
              class="project-row grid grid-cols-1 lg:grid-cols-12 gap-12 items-center transition-opacity duration-500"
              data-category={firstProject.category}
              data-role={firstProject.role}
            >
              
              <!-- Kolom Mockup Gambar -->
              <div class="image-col lg:col-span-7 w-full lg:order-first">
                <div class="relative bg-neutral-900 dark:bg-neutral-950 rounded-2xl p-4 sm:p-6 shadow-xl border border-neutral-200/60 dark:border-neutral-800 group overflow-hidden">
                  <div class="aspect-video w-full rounded-lg overflow-hidden bg-neutral-800 flex items-center justify-center">
                    {firstProject.image ? (
                      <img 
                        src={firstProject.image} 
                        alt={firstProject.title} 
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                    ) : (
                      <span class="text-neutral-500 text-sm font-mono">💻 Mockup_{firstProject.title.replace(/\s+/g, '_')}.png</span>
                    )}
                  </div>
                </div>
              </div>

              <!-- Kolom Informasi Detail -->
              <div class="lg:col-span-5 flex flex-col justify-center">
                <span class="text-xs font-mono tracking-wider text-neutral-400 dark:text-neutral-500 block mb-2">
                  {firstProject.category || "BACKEND / FULL-STACK"}
                </span>
                
                <h2 class="text-3xl font-black tracking-tight text-neutral-900 dark:text-white mb-4 capitalize">
                  {firstProject.title.toLowerCase()}
                </h2>
                
                <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-6">
                  {firstProject.solution}
                </p>

                <div class="grid grid-cols-3 gap-4 py-5 border-t border-b border-neutral-200 dark:border-neutral-800 mb-8 text-sm">
                  <div>
                    <span class="text-xs font-bold text-neutral-400 dark:text-neutral-500 block uppercase mb-1">Role</span>
                    <span class="font-medium text-neutral-800 dark:text-neutral-200">{firstProject.role || "Full-stack"}</span>
                  </div>
                  <div>
                    <span class="text-xs font-bold text-neutral-400 dark:text-neutral-500 block uppercase mb-1">Toolkit</span>
                    <span class="font-medium text-neutral-800 dark:text-neutral-200 block truncate">{firstProject.techStack.slice(0, 2).join(" · ")}</span>
                  </div>
                  <div>
                    <span class="text-xs font-bold text-neutral-400 dark:text-neutral-500 block uppercase mb-1">Year</span>
                    <span class="font-medium text-neutral-800 dark:text-neutral-200">{firstProject.year || "2026"}</span>
                  </div>
                </div>

                <div class="flex gap-4">
                  <!-- TOMBOL VISIT SITE -->
                  {!firstProject.liveUrl || firstProject.liveUrl === '#' ? (
                    <button 
                      type="button" 
                      class="rounded-full px-6 py-2 bg-neutral-200 dark:bg-neutral-700 text-neutral-500 dark:text-neutral-400 opacity-50 cursor-not-allowed font-medium"
                    >
                      Visit Site ↗
                    </button>
                  ) : (
                    <Button 
                      href={firstProject.liveUrl} 
                      target="_blank"
                      rel="noopener noreferrer"
                      class="rounded-full px-6 py-2"
                    >
                      Visit Site ↗
                    </Button>
                  )}
                  
                  <!-- TOMBOL SOURCE CODE -->
                  {firstProject.githubUrl && (
                    <a href={firstProject.githubUrl} target="_blank" rel="noopener noreferrer">
                      <Button variant="secondary" class="rounded-full px-6 py-2">
                        Source Code
                      </Button>
                    </a>
                  )}
                </div>
              </div>
            </div>
          ) : (
            <div class="text-center py-20">
              <p class="text-neutral-500 dark:text-neutral-400 text-lg">Belum ada proyek yang ditambahkan.</p>
            </div>
          )
        }
        
        <!-- Pesan Kosong Jika Filter Tidak Cocok -->
        <div id="no-results-msg" class="hidden text-center py-20">
          <p class="text-neutral-500 dark:text-neutral-400 text-lg">Tidak ada proyek yang sesuai dengan kriteria filter Anda.</p>
        </div>
      </div>

    <Container class="flex items-center justify-center mt-12">
        <Button
            href={`${import.meta.env.BASE_URL}/projects`}
            class="hover"
        >
            View All Projects
        </Button>
    </Container>
      
    </Container>
  </Section>

<!-- SCRIPT LOGIKA FILTER -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const categorySelect = document.getElementById("filter-category") as HTMLSelectElement;
    const roleSelect = document.getElementById("filter-role") as HTMLSelectElement;
    const projectRow = document.querySelector(".project-row") as HTMLElement;
    const noResultsMsg = document.getElementById("no-results-msg");

    function applyFilters() {
      if (!projectRow) return;

      const selectedCategory = categorySelect.value;
      const selectedRole = roleSelect.value;

      const rowCategory = projectRow.getAttribute("data-category");
      const rowRole = projectRow.getAttribute("data-role");

      const matchCategory = selectedCategory === "ALL" || rowCategory === selectedCategory;
      const matchRole = selectedRole === "ALL" || rowRole === selectedRole;

      if (matchCategory && matchRole) {
        projectRow.style.display = "grid";
        if (noResultsMsg) noResultsMsg.classList.add("hidden");
      } else {
        projectRow.style.display = "none";
        if (noResultsMsg) noResultsMsg.classList.remove("hidden");
      }
    }

    categorySelect.addEventListener("change", applyFilters);
    roleSelect.addEventListener("change", applyFilters);
  });
</script>