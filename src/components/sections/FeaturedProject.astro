---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
import ImageCarousel from "../ui/ImageCarousel.astro";
import { Icon } from "astro-icon/components";
import { Projects } from "@/data/projects";
import { resolveProjectImages } from "@/utils/project-images";
---

<Section
  class="bg-white py-20 transition-colors duration-300 sm:py-28 dark:bg-neutral-950"
>
  <Container id="projects">
    <!-- Header -->
    <div class="mx-auto max-w-2xl text-center" data-anim="up" data-anim-stagger>
      <p
        class="text-sm font-semibold uppercase tracking-widest text-blue-600 dark:text-blue-400"
        data-anim="fade"
      >
        Featured Work
      </p>
      <h2
        class="mt-3 text-3xl font-extrabold tracking-tight text-neutral-900 sm:text-4xl dark:text-white"
        data-anim="fade"
        data-anim-delay="80"
      >
        Projects I've <span class="text-blue-600 dark:text-blue-400">Built</span>
      </h2>
      <p
        class="mt-4 text-base text-neutral-600 dark:text-neutral-400"
        data-anim="fade"
        data-anim-delay="160"
      >
        Full-stack applications showcasing backend architecture, API design, and modern UI implementation.
      </p>
    </div>

    <!-- Project Grid -->
    <div class="mt-14 grid gap-8" data-anim-child="up">
      {Projects.map((project) => {
        const images = resolveProjectImages(project);
        const cover = images[0];
        return (
        <article
          class="group relative flex flex-col gap-6 overflow-hidden rounded-2xl border border-neutral-200 bg-white transition-all duration-300 hover:border-blue-500 hover:shadow-xl hover:shadow-neutral-900/5 dark:border-neutral-800 dark:bg-neutral-900/40 dark:hover:border-blue-400 sm:grid sm:grid-cols-12 sm:gap-6"
        >
          <!-- Image -->
          <div class="relative aspect-video w-full overflow-hidden bg-neutral-100 sm:col-span-5 sm:aspect-[4/3] dark:bg-neutral-800">
            {cover ? (
              <ImageCarousel
                images={images}
                alt={project.title}
                imgClass="transition-transform duration-500 group-hover:scale-105"
              />
            ) : (
              <div class="flex h-full w-full items-center justify-center">
                <span class="text-4xl">💻</span>
              </div>
            )}

            <!-- Badges -->
            <div class="absolute left-3 top-3 flex flex-col gap-1.5">
              <span class="inline-flex items-center gap-1 rounded-full bg-white/90 px-2.5 py-0.5 text-xs font-bold text-neutral-800 backdrop-blur-sm dark:bg-neutral-950/80 dark:text-neutral-200">
                <Icon name="mdi:calendar-month" class="h-2.5 w-2.5" />
                {project.year}
              </span>
              <span class="inline-flex items-center gap-1 rounded-full bg-blue-600/90 px-2.5 py-0.5 text-xs font-bold text-white backdrop-blur-sm">
                {project.category}
              </span>
            </div>
            {images.length > 1 && (
              <span class="absolute bottom-3 right-3 inline-flex items-center gap-1 rounded-full bg-black/60 px-2.5 py-1 text-xs font-bold text-white backdrop-blur-sm">
                <Icon name="mdi:image-multiple" class="h-3 w-3" />
                {images.length}
              </span>
            )}
          </div>

          <!-- Content -->
          <div class="flex flex-col p-6 sm:col-span-7 sm:p-7">
            <h3
              class="text-lg font-bold tracking-tight text-neutral-900 transition-colors group-hover:text-blue-600 sm:text-xl dark:text-white dark:group-hover:text-blue-400"
            >
              {project.title}
            </h3>

            <p
              class="mt-2 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400"
            >
              {project.solution.slice(0, 120)}...
            </p>

            <!-- Tech Stack -->
            <div class="mt-4 flex flex-wrap gap-1.5">
              {project.techStack.slice(0, 4).map((tech) => (
                <span
                  class="inline-flex items-center rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs font-medium text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300"
                >
                  {tech}
                </span>
              ))}
              {project.techStack.length > 4 && (
                <span
                  class="inline-flex items-center rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs font-medium text-neutral-500 dark:bg-neutral-800 dark:text-neutral-400"
                >
                  +{project.techStack.length - 4}
                </span>
              )}
            </div>

            <!-- Meta -->
            <div
              class="mt-4 flex items-center gap-4 text-xs text-neutral-500 dark:text-neutral-400"
            >
              <span class="inline-flex items-center gap-1">
                <Icon name="mdi:account-tie" class="h-3 w-3" />
                {project.role}
              </span>
              <span class="inline-flex items-center gap-1">
                <Icon name="mdi:calendar" class="h-3 w-3" />
                {project.year}
              </span>
            </div>

            {/* Actions */}
            <div class="mt-4 flex flex-wrap gap-3">
              <a
                href={`${import.meta.env.BASE_URL}/projects/${project.slug}/`}
                class="inline-flex items-center gap-1.5 rounded-xl bg-neutral-900 px-4 py-2 text-xs font-semibold text-white transition-all duration-200 hover:bg-neutral-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200"
              >
                Detail
                <Icon name="mdi:arrow-right" class="h-3 w-3" />
              </a>
              {project.liveUrl && project.liveUrl !== "#" ? (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-xl bg-neutral-900 px-4 py-2 text-xs font-semibold text-white transition-all duration-200 hover:bg-neutral-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200"
                >
                  Live
                  <Icon name="mdi:arrow-top-right" class="h-3 w-3" />
                </a>
              ) : (
                <span
                  class="inline-flex cursor-not-allowed items-center gap-1.5 rounded-xl bg-neutral-200 px-4 py-2 text-xs font-semibold text-neutral-500 opacity-60 dark:bg-neutral-800 dark:text-neutral-400"
                >
                  Live
                  <Icon name="mdi:lock" class="h-3 w-3" />
                </span>
              )}

              {project.githubUrl && (
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-xl border border-neutral-300 px-4 py-2 text-xs font-semibold text-neutral-700 transition-all duration-200 hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-200 dark:hover:bg-neutral-800"
                >
                  <Icon name="mdi:github" class="h-3 w-3" />
                  Code
                </a>
              )}
            </div>
          </div>
        </article>
      )})}
    </div>

    <!-- CTA -->
    <div class="mt-14 flex justify-center" data-anim="up">
      <Button
        href={`${import.meta.env.BASE_URL}/projects`}
        variant="secondary"
        class="rounded-full px-8 py-3 text-sm"
        data-magnetic="0.15"
      >
        View All Projects
        <Icon name="mdi:arrow-right" class="ml-2 h-4 w-4" />
      </Button>
    </div>
  </Container>
</Section>