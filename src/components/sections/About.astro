---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Badge from "../ui/Badge.astro";
import { Image } from "astro:assets";
import profileImage from "../../assets/images/profile.webp";
import { profile } from "../../data/profile";
import { skills } from "@/data/skills";
import { Icon } from "astro-icon/components";

const location = profile.location ?? "Indonesia";
const yearsExperience = profile.yearsExperience ?? 2;
const projectsCount = profile.projectsCount ?? 10;
const availability = profile.availability ?? "Open to Work";

const quickFacts = [
  { label: "Location", value: location },
  { label: "Experience", value: `${yearsExperience}+ years` },
  { label: "Status", value: availability },
];

const stack: string[] = profile.stack ?? [
  "JavaScript",
  "TypeScript",
  "React",
  "Laravel",
  "Tailwind CSS",
  "PostgreSQL",
  "MySQL"
];
---

<Section class="bg-neutral-50 py-20 transition-colors duration-300 sm:py-28 dark:bg-neutral-900/40">
  <Container id="about">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] lg:gap-16">

      <!-- Left: photo + quick facts -->
      <div class="mx-auto w-full max-w-sm lg:mx-0" data-anim="up" data-anim-stagger>
        <div class="relative" data-anim="zoom">
          <div
            class="flex aspect-square w-full items-center justify-center rounded-3xl bg-neutral-200 text-neutral-500 shadow-xl dark:bg-neutral-800 dark:text-neutral-400 dark:shadow-neutral-900/50 overflow-hidden"
          >
            <Image
              src={profileImage}
              alt="Foto Profil"
              class="w-full h-full object-cover"
              width={320}
              height={320}
              loading="eager"
              fetchpriority="high"
            />
          </div>

          <!-- Decorative pulsing dot -->
          <div class="absolute -bottom-4 -right-4 flex h-8 w-8 items-center justify-center rounded-full bg-blue-500/20 text-blue-600 animate-pulse dark:bg-blue-500/30">
            <Icon name="mdi:server" class="h-4 w-4" />
          </div>
        </div>

        <dl
          class="mt-6 divide-y divide-neutral-200 rounded-2xl border border-neutral-200 bg-white dark:divide-neutral-800 dark:border-neutral-800 dark:bg-neutral-900"
          data-anim="up"
          data-anim-delay="150"
        >
          {quickFacts.map((fact) => (
            <div class="flex items-center justify-between px-5 py-3.5">
              <dt class="text-sm text-neutral-500 dark:text-neutral-400">
                {fact.label}
              </dt>
              <dd class="text-sm font-semibold text-neutral-900 dark:text-white">
                {fact.value}
              </dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- Right: bio + stats + stack -->
      <div class="pt-0.5" data-anim="up" data-anim-stagger>
        <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-3" data-anim="fade">
          Hi, I'm {profile.name.split(" - ")[0]}
        </h3>
        <p
          class="text-base leading-relaxed text-neutral-600 dark:text-neutral-400 mb-6"
          data-anim="fade"
          data-anim-delay="80"
        >
          {profile.bio}
        </p>

        <!-- Stats -->
        <div
          class="mb-8 grid grid-cols-2 gap-x-8 gap-y-4 border-y border-neutral-200 py-6 dark:border-neutral-800"
          data-anim="up"
          data-anim-delay="160"
        >
        <div>
          <p
            class="text-3xl font-extrabold tabular-nums text-neutral-900 sm:text-4xl dark:text-white"
            data-stat={yearsExperience}
          >
            {yearsExperience}+
          </p>
          <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
            Years of Experience
          </p>
        </div>
        <div>
          <p
            class="text-3xl font-extrabold tabular-nums text-neutral-900 sm:text-4xl dark:text-white"
            data-stat={projectsCount}
          >
            {projectsCount}+
          </p>
          <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
            Projects Completed
          </p>
        </div>
        </div>

        <!-- Core Stack with icons -->
        <div>
          <p
            class="text-sm font-semibold text-neutral-900 dark:text-white"
            data-anim="fade"
            data-anim-delay="240"
          >
            Core Stack
          </p>
          <div class="mt-3 flex flex-wrap gap-2" data-anim-child="up">
            {stack.map((tech) => {
              const matchedSkill = skills.find(
                (s) => s.name.toLowerCase() === tech.toLowerCase()
              );
              return (
                <span
                  class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1 text-sm font-medium text-neutral-700 shadow-sm ring-1 ring-neutral-200 dark:bg-neutral-900 dark:text-neutral-300 dark:ring-neutral-800"
                >
                  {matchedSkill && (
                    <Icon name={matchedSkill.icon} class="h-4 w-4" style={`color: ${matchedSkill.color}`} />
                  )}
                  {tech}
                </span>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </Container>
</Section>