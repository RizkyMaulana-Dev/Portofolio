---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Badge from "../ui/Badge.astro";
import { Certificates } from "@/data/certificates";

// Kategori unik untuk filter badge
const uniqueCategories = ["All", ...new Set(Certificates.map(c => c.category))];
---

<Section class="bg-neutral-50 py-20 transition-colors duration-300 sm:py-28 dark:bg-neutral-900/40">
  <Container id="certificates">
    
    <!-- Section Header -->
    <div class="mx-auto max-w-2xl text-center" data-anim="up" data-anim-stagger>
      <p
        class="text-sm font-semibold uppercase tracking-widest text-blue-600 dark:text-blue-400"
        data-anim="fade"
      >
        Certifications
      </p>
      <h2
        class="mt-3 text-3xl font-extrabold tracking-tight text-neutral-900 sm:text-4xl dark:text-white"
        data-anim="fade"
        data-anim-delay="80"
      >
        Licenses & <span class="text-blue-600 dark:text-blue-400">Certificates</span>
      </h2>
      <p
        class="mt-4 text-base text-neutral-600 dark:text-neutral-400"
        data-anim="fade"
        data-anim-delay="160"
      >
        Kumpulan sertifikasi profesional dan kursus yang telah saya selesaikan untuk memperdalam kompetensi di berbagai domain teknologi.
      </p>
    </div>

    <!-- Category Filter Badges -->
    <div class="mt-10 flex flex-wrap justify-center gap-2" data-anim="up" data-anim-delay="200">
      {uniqueCategories.map((cat, i) => (
        <button
          data-cert-filter={cat}
        class={`cert-filter-btn cursor-pointer rounded-full px-4 py-1.5 text-xs font-semibold transition-all duration-200 ${
              i === 0
                ? "bg-blue-600 text-white dark:bg-blue-400 shadow-sm"
                : "bg-white text-neutral-600 border border-neutral-200 hover:border-blue-500 hover:text-blue-600 dark:bg-neutral-900 dark:text-neutral-400 dark:border-neutral-800 dark:hover:border-blue-400 dark:hover:text-blue-400"
            }`}
          >
          {cat}
        </button>
      ))}
    </div>

    <!-- Certificates Grid -->
    <div id="certificates-grid" class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-anim-child="up">
      {
        Certificates.map((cert) => (
          <div
            class="cert-card group relative flex flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-white transition-all duration-300 hover:shadow-lg hover:border-neutral-300 dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-neutral-700 dark:hover:shadow-neutral-950/40"
            data-cert-category={cert.category}
          >
            {/* Certificate Image / Preview */}
            <div class="relative aspect-[4/3] w-full overflow-hidden bg-neutral-100 dark:bg-neutral-800">
              {cert.image ? (
                <img
                  src={cert.image}
                  alt={cert.title}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center">
                  <div class="text-center">
                    <span class="text-4xl">📜</span>
                    <p class="mt-2 text-xs font-mono text-neutral-400 dark:text-neutral-500">
                      Certificate Preview
                    </p>
                  </div>
                </div>
              )}

              {/* Category Pill Overlay */}
              <span class="absolute top-3 right-3 inline-flex items-center rounded-full bg-white/90 px-2.5 py-0.5 text-xs font-semibold text-neutral-700 backdrop-blur-sm dark:bg-neutral-900/90 dark:text-neutral-300">
                {cert.category}
              </span>
            </div>

            {/* Card Body */}
            <div class="flex flex-1 flex-col p-5">
              {/* Issuer */}
              <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-1.5">
                {cert.issuer}
              </span>

              {/* Title */}
              <h3 class="text-base font-bold tracking-tight text-neutral-900 dark:text-white leading-snug mb-2">
                {cert.title}
              </h3>

              {/* Meta Row */}
              <div class="mt-auto flex items-center justify-between pt-4 border-t border-neutral-100 dark:border-neutral-800">
                <div class="flex flex-col gap-0.5">
                  <span class="text-xs text-neutral-400 dark:text-neutral-500">Diterbitkan</span>
                  <span class="text-xs font-medium text-neutral-700 dark:text-neutral-300">
                    {cert.date}
                  </span>
                </div>
                
                {cert.credentialUrl && cert.credentialUrl !== "#" ? (
                  <a
                    href={cert.credentialUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-semibold text-blue-600 bg-blue-50 hover:bg-blue-100 transition-colors dark:text-blue-400 dark:bg-blue-950/40 dark:hover:bg-blue-950/60"
                  >
                    Lihat Kredensial ↗
                  </a>
                ) : (
                  <span class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-medium text-neutral-400 bg-neutral-100 dark:text-neutral-500 dark:bg-neutral-800 cursor-default">
                    Credential ID
                  </span>
                )}
              </div>

              {/* Credential ID */}
              {cert.credentialId && (
                <p class="mt-2.5 text-[10px] font-mono text-neutral-400 dark:text-neutral-600 truncate">
                  ID: {cert.credentialId}
                </p>
              )}
            </div>
          </div>
        ))
      }
    </div>

    <!-- Empty State -->
    <div id="cert-no-results" class="hidden text-center py-16">
      <p class="text-neutral-500 dark:text-neutral-400 text-base">
        Tidak ada sertifikat dalam kategori ini.
      </p>
    </div>

  </Container>
</Section>

<!-- Client-Side Filter Script -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const filterBtns = document.querySelectorAll(".cert-filter-btn");
    const certCards = document.querySelectorAll(".cert-card");
    const noResults = document.getElementById("cert-no-results");

    // Style tokens untuk tombol aktif dan tidak aktif
    const activeClasses = ["bg-blue-600", "text-white", "dark:bg-blue-400", "shadow-sm"];
    const inactiveClasses = [
      "bg-white", "text-neutral-600", "border", "border-neutral-200",
      "hover:border-blue-500", "hover:text-blue-600",
      "dark:bg-neutral-900", "dark:text-neutral-400", "dark:border-neutral-800",
      "dark:hover:border-blue-400", "dark:hover:text-blue-400"
    ];

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const selected = btn.getAttribute("data-cert-filter");

        // Update gaya tombol aktif
        filterBtns.forEach((b) => {
          b.classList.remove(...activeClasses);
          b.classList.add(...inactiveClasses);
        });
        btn.classList.remove(...inactiveClasses);
        btn.classList.add(...activeClasses);

        // Filter kartu
        let visibleCount = 0;
        certCards.forEach((card) => {
          const cardCategory = card.getAttribute("data-cert-category");
          const isMatch = selected === "All" || cardCategory === selected;
          
          if (isMatch) {
            (card as HTMLElement).style.display = "flex";
            visibleCount++;
          } else {
            (card as HTMLElement).style.display = "none";
          }
        });

        // Tampilkan empty state jika perlu
        if (visibleCount === 0 && noResults) {
          noResults.classList.remove("hidden");
        } else if (noResults) {
          noResults.classList.add("hidden");
        }
      });
    });
  });
</script>
