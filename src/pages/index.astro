---
import MainLayout from "../layouts/MainLayout.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Hero from "@/components/sections/Hero.astro";
import About from "@/components/sections/About.astro";
import TechStack from "@/components/sections/TechStack.astro";
import FeaturedProject from "@/components/sections/FeaturedProject.astro";
import Experience from "@/components/sections/Experience.astro";
import Certificates from "@/components/sections/Certificates.astro";
---

<MainLayout
  title="Rizky Maulana - Fullstack Developer Portfolio"
  description="Portfolio of Rizky Maulana, a Full Stack Web Developer specializing in React, TypeScript, Laravel, Node.js, and modern web applications."
>
  <Section>
    <Container>
      <Hero />
      <About />
      <TechStack />
      <FeaturedProject />
      <Experience />
      <Certificates />
    </Container>
  </Section>
</MainLayout>