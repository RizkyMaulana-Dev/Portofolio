---
import "../styles/global.css";

import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Rizky Maulana - Fullstack Developer | Indonesia",
  description = "Rizky Maulana is a Full Stack Developer from Indonesia specializing in React, TypeScript, Laravel, Node.js, REST APIs, and modern web applications.",
} = Astro.props;
---

<!doctype html>
<html lang="id-ID">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- SEO Dasar -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={Astro.url.href} />   

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/Logo.svg`} />
    <link rel="alternate icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}/Logo.ico`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}/Logo.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}/site.webmanifest`} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${import.meta.env.BASE_URL}/og-image.svg`, Astro.site)} />

    <!-- Twitter Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(`${import.meta.env.BASE_URL}/og-image.svg`, Astro.site)} />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

    
    <script type="application/ld+json">
        {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        "mainEntity": {
            "@type": "Person",
            "@id": "https://rizkymaulana-dev.github.io/Portofolio/#person",
            "name": "Rizky Maulana",
            "jobTitle": "Full Stack Developer",
            "url": "https://rizkymaulana-dev.github.io/Portofolio/",
            "image": "https://rizkymaulana-dev.github.io/Portofolio/images/profile.webp",
            "description": "Full Stack Developer from Indonesia specializing in React, TypeScript, Laravel, Node.js, and REST API development.",
            "sameAs": [
            "https://github.com/RizkyMaulana310807",
            "https://www.linkedin.com/in/rzkymaulana"
            ]
        }
        }
        </script>
    
    <!-- Cegah flash tema salah saat halaman load -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;

        const isDark = stored ? stored === "dark" : prefersDark;

        document.documentElement.classList.toggle("dark", isDark);
        document.documentElement.classList.add("has-anim");
      })();
    </script>
  </head>
  <body
    class="min-h-screen bg-white text-neutral-900 antialiased transition-colors duration-300 dark:bg-neutral-950 dark:text-neutral-100"
  >
    <Navbar />

    <main class="w-full overflow-x-hidden">
      <slot />
    </main>

    <Footer />

    <!-- Global Motion Animations -->
    <script type="module">
      import { inView, animate } from "motion";

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!reduced) {
        // 1. Universal fade + slide for [data-anim]
        const animateEl = (el: HTMLElement) => {
          const type = el.dataset.anim || "up";
          const delay = Number(el.dataset.animDelay || 0);
          const duration = 0.6;
          const ease = [0.16, 1, 0.3, 1] as const;

          const keyframes: Record<string, Record<string, [string, string]>> = {
            fade: { opacity: ["0", "1"] },
            up: { opacity: ["0", "1"], transform: ["translateY(24px)", "translateY(0)"] },
            down: { opacity: ["0", "1"], transform: ["translateY(-24px)", "translateY(0)"] },
            left: { opacity: ["0", "1"], transform: ["translateX(-24px)", "translateX(0)"] },
            right: { opacity: ["0", "1"], transform: ["translateX(24px)", "translateX(0)"] },
            zoom: { opacity: ["0", "1"], scale: ["0.92", "1"] },
          };

          animate(el, keyframes[type] || keyframes.up, { delay, duration, ease });
        };

        const inStagger = (el: Element) =>
          el.closest("[data-anim-stagger], [data-anim-child]") !== null;

        // Standalone [data-anim] elements (own inView + own delay)
        document
          .querySelectorAll("[data-anim]")
          .forEach((el) => {
            if (inStagger(el)) return;
            inView(
              el,
              () => animateEl(el as HTMLElement),
              { amount: 0.15, once: true }
            );
          });

        // [data-anim-stagger] parents: auto-stagger their [data-anim] children
        document.querySelectorAll("[data-anim-stagger]").forEach((parent) => {
          const kids = [...parent.querySelectorAll("[data-anim]")] as HTMLElement[];
          const items: HTMLElement[] = parent.hasAttribute("data-anim")
            ? [parent as HTMLElement, ...kids]
            : kids;
          if (!items.length) return;
          const amount = Number(parent.dataset.animStagger || 0.08);
          inView(
            parent,
            () => {
              items.forEach((child, i) => {
                child.dataset.animDelay = String(amount * i);
                animateEl(child);
              });
            },
            { amount: 0.15, once: true }
          );
        });

        // [data-anim-child] parents: auto-stagger all direct children
        document.querySelectorAll("[data-anim-child]").forEach((parent) => {
          const children = [...parent.children] as HTMLElement[];
          if (!children.length) return;
          const amount = 0.09;
          inView(
            parent,
            () => {
              children.forEach((child, i) => {
                if (!child.dataset.anim) child.dataset.anim = "up";
                child.dataset.animDelay = String(amount * i);
                animateEl(child);
              });
            },
            { amount: 0.15, once: true }
          );
        });

        // 2. Stat count-up
        document.querySelectorAll("[data-stat]").forEach((el) => {
          const target = Number(el.dataset.stat);
          inView(
            el,
            () => {
              let raf = 0;
              const start = performance.now();
              const dur = 1200;
              const tick = (now: number) => {
                const p = Math.min((now - start) / dur, 1);
                const eased = 1 - Math.pow(1 - p, 3);
                el.textContent = `${Math.round(target * eased)}+`;
                if (p < 1) raf = requestAnimationFrame(tick);
              };
              raf = requestAnimationFrame(tick);
            },
            { amount: 0.2, once: true }
          );
        });

        // 3. Magnetic hover on interactive elements (opt-in)
        document.querySelectorAll("[data-magnetic]").forEach((el) => {
          const strength = Number(el.dataset.magnetic || 0.2);
          const onMove = (e: MouseEvent) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left - r.width / 2) * strength;
            const y = (e.clientY - r.top - r.height / 2) * strength;
            animate(el, { x, y }, { type: "spring", stiffness: 200, damping: 15 });
          };
          const onLeave = () => animate(el, { x: 0, y: 0 }, { type: "spring", stiffness: 200, damping: 15 });
          el.addEventListener("mousemove", onMove);
          el.addEventListener("mouseleave", onLeave);
        });
      }
    </script>
  </body>
</html>